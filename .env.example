# Copy to .env and fill in. Never commit .env.

# Required: bot token (Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=

# Your Discord user id(s), comma-separated. Required for /wm list, update_order,
# sold, unlist, my_orders and status (they act on YOUR warframe.market account).
OWNER_ID=

# warframe.market account for the owner commands: a JWT cookie (preferred)...
WFM_JWT=
# ...or email + password (sign-in may be blocked by Cloudflare)
WFM_EMAIL=
WFM_PASSWORD=

# Optional
WFM_PLATFORM=pc        # default platform for market lookups: pc, ps4, xbox, switch, mobile
LOG_LEVEL=INFO
LOG_FILE=log.log       # empty = console only

# Optional REST API (uvicorn api.main:app)
WFBOT_API_KEY=
WFBOT_CORS=*
