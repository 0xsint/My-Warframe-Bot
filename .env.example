# Copy to .env and fill in. Never commit .env.

# Required: bot token (Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=

# Anyone can link their own warframe.market account with /wm link. The account
# below is optional: it lets the bot owner(s) use their account without linking.
OWNER_ID=              # your Discord user id(s), comma-separated
WFM_JWT=               # JWT cookie (preferred)...
WFM_EMAIL=             # ...or email + password (may be blocked by Cloudflare)
WFM_PASSWORD=

# Key that encrypts tokens saved by /wm link. Leave empty to auto-generate
# data/secret.key on first use (back it up). Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WFBOT_SECRET_KEY=
WFBOT_DATA_DIR=data    # where linked accounts are stored

# Optional
WFM_PLATFORM=pc        # default platform for market lookups: pc, ps4, xbox, switch, mobile
LOG_LEVEL=INFO
LOG_FILE=log.log       # empty = console only

# Optional REST API (uvicorn api.main:app)
WFBOT_API_KEY=
WFBOT_CORS=*
